step "run-a-docker-container" {
    name = "Run a Docker Container"
    properties = {
        Octopus.Action.TargetRoles = "interstellar-targets"
    }

    action {
        action_type = "Octopus.DockerRun"
        properties = {
            Octopus.Action.Docker.NetworkType = "host"
            Octopus.Action.Docker.PortMapping = "{}"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "intersteller"
            Octopus.Action.Package.PackageId = "Interstellar"
            Octopus.Action.RunOnServer = "false"
        }
        worker_pool_variable = ""

        packages {
            acquisition_location = "Server"
            feed = "intersteller"
            package_id = "Interstellar"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}